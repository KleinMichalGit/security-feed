<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily Security Briefing</title>
    <style>
        body {
            background-color: #012456;
            color: #F2F2F2;
            font-family: 'Consolas', 'Lucida Console', monospace;
            padding: 20px;
            line-height: 1.6;
            max-width: 1000px;
            margin: auto;
        }
        h1 { color: #FFFFFF; font-size: 1.4em; border-bottom: 2px solid #F2F2F2; padding-bottom: 10px; margin-bottom: 30px; }
        .menu { margin-bottom: 40px; }
        .menu ul { list-style-type: decimal-leading-zero; padding-left: 25px; }
        .menu li { margin-bottom: 14px; color: #EBCB8B; }
        .meta { display: block; color: #A3BE8C; font-size: 0.85em; }
        .tag { color: #EBCB8B; }
        button {
            background: none; border: none; color: #F2F2F2;
            text-align: left; cursor: pointer; font-family: inherit;
            font-size: 1.05em; padding: 0;
        }
        button:hover { color: #FFFF00; text-decoration: underline; }
        .article-body { display: none; margin-top: 20px; }
        .article-body.active { display: block; }
        .article-title { color: #FFFFFF; font-size: 1.3em; margin-bottom: 5px; }
        .source-link { color: #A3BE8C; font-size: 0.9em; }
        .source-link a { color: #A3BE8C; text-decoration: none; }
        .source-link a:hover { text-decoration: underline; }
        .content {
            padding: 15px 0;
            border-top: 1px solid #4C566A;
            margin-top: 15px;
            overflow-wrap: anywhere;
        }
        .content a { color: #88C0D0; }
        .content h2, .content h3, .content h4 { color: #FFFFFF; font-size: 1.1em; margin-top: 1.6em; }
        .content img { display: block; max-width: 100%; height: auto; margin: 16px 0; background: #F2F2F2; }
        .content figure { margin: 16px 0; }
        .content figcaption { color: #A3BE8C; font-size: 0.85em; }
        .content pre { background: #001633; border: 1px solid #4C566A; padding: 12px; overflow-x: auto; overflow-wrap: normal; }
        .content code { background: #001633; padding: 0 3px; }
        .content pre code { padding: 0; }
        .content blockquote { border-left: 3px solid #EBCB8B; margin: 16px 0; padding-left: 14px; color: #D8DEE9; }
        .table-wrap { overflow-x: auto; margin: 16px 0; }
        .content table { border-collapse: collapse; min-width: 50%; overflow-wrap: normal; }
        .content th, .content td { border: 1px solid #4C566A; padding: 6px 10px; text-align: left; vertical-align: top; }
        .content th { background: #001633; color: #FFFFFF; }
        .note { color: #EBCB8B; font-style: italic; }
        .back-btn { color: #FFFF00; border: 1px solid #FFFF00; padding: 6px 12px; margin-top: 15px; transition: 0.2s; }
        .back-btn:hover { background: #FFFF00; color: #012456; }
        .separator { border: 0; border-top: 1px dashed #4C566A; margin: 50px 0; }
        footer {
            text-align: center;
            margin-top: 60px;
            padding: 30px;
            border-top: 1px solid #4C566A;
            font-size: 0.85em;
            color: #A3BE8C;
        }
        footer a { color: #A3BE8C; text-decoration: underline; }
        .disclaimer { opacity: 0.8; font-size: 0.9em; max-width: 700px; margin: 15px auto; line-height: 1.4; }
        @media (max-width: 600px) {
            body { padding: 15px; font-size: 15px; }
            h1 { font-size: 1.2em; }
            .menu ul { padding-left: 20px; }
        }
    </style>
</head>
<body>
    <h1>Security Briefing // {{ generated }}</h1>
    <div class="menu">
        <ul>
        {% for a in articles %}
            <li>
                <button data-target="art-{{ loop.index0 }}">{{ a.title }}</button>
                <span class="meta"><span class="tag">[{{ a.category }}]</span> {{ a.source }} · {{ a.date }}{% if a.also %} · also: {{ a.also | join(", ") }}{% endif %}</span>
            </li>
        {% endfor %}
        </ul>
    </div>
    {% for a in articles %}
    <div id="art-{{ loop.index0 }}" class="article-body">
        <h2 class="article-title">{{ a.title }}</h2>
        <p class="source-link">[{{ a.category }}] {{ a.source }} · {{ a.date }} | <a href="{{ a.link }}" target="_blank" rel="noopener noreferrer">Original link</a></p>
        <div class="content">
            {{ a.body | safe }}
            {% if a.origin == "summary" %}<p class="note">Full content could not be extracted. Read the article at the source.</p>{% endif %}
        </div>
        <button class="back-btn">[ Back to Menu ]</button>
        <hr class="separator">
    </div>
    {% endfor %}
    <script>
        document.querySelectorAll('.menu button').forEach(btn => btn.addEventListener('click', () => {
            document.querySelectorAll('.article-body').forEach(el => el.classList.remove('active'));
            const target = document.getElementById(btn.dataset.target);
            target.classList.add('active');
            target.scrollIntoView({behavior: 'smooth'});
        }));
        document.querySelectorAll('.back-btn').forEach(btn => btn.addEventListener('click', () => window.scrollTo(0, 0)));
    </script>
    <footer>
        <p>News aggregator designed and maintained by <a href="https://github.com/KleinMichalGit/security-feed" target="_blank" rel="noopener noreferrer">Michal Klein</a></p>
        <div class="disclaimer">
            <p>This is an <strong>open-source educational project</strong> intended for research and personal productivity. The aggregator is available on <a href="https://github.com/KleinMichalGit/security-feed" target="_blank" rel="noopener noreferrer">GitHub</a>.</p>
            <p><em>Notice: The articles above are automated scrapes from third-party RSS feeds. Full credit belongs to the original authors and publications linked in each source. This site does not claim ownership of the reported content.</em></p>
        </div>
    </footer>
</body>
</html>
